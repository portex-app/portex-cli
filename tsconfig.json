{
    "compilerOptions": {
        "declaration": true,
        "module": "Node16",
        "moduleResolution": "node16",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "target": "es2022",
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": [
        "./src/**/*"
    ],
    "ts-node": {
        "esm": true
    }
}
